  "@graph": [
    {"@id": "deg:ChargingCommitment", "@type": "rdfs:Class", "rdfs:label": "EV Charging Commitment", "rdfs:comment": "A driver's charging request and the CPO's quote for it."},
    {"@id": "deg:Vehicle", "@type": "rdfs:Class", "rdfs:label": "Vehicle", "rdfs:subClassOf": "schema:Vehicle"},
    {"@id": "deg:vehicle", "@type": "rdf:Property", "rdfs:label": "Vehicle", "rdfs:domain": "deg:ChargingCommitment", "schema:rangeIncludes": "deg:Vehicle"},
    {"@id": "deg:maxChargeKW", "@type": "rdf:Property", "rdfs:label": "Maximum charge power", "rdfs:comment": "Maximum power the vehicle accepts (kW).", "rdfs:domain": "deg:Vehicle", "schema:rangeIncludes": "xsd:decimal"},
    {"@id": "deg:socPercent", "@type": "rdf:Property", "rdfs:label": "State of charge", "rdfs:comment": "State of charge when requesting (%).", "rdfs:domain": "deg:Vehicle", "schema:rangeIncludes": "xsd:decimal"},
    {"@id": "deg:reservedStart", "@type": "rdf:Property", "rdfs:label": "Reserved start", "rdfs:comment": "Reserved start time; RESERVATION mode only.", "rdfs:domain": "deg:ChargingCommitment", "schema:rangeIncludes": "xsd:dateTime"},
    {"@id": "deg:Quote", "@type": "rdfs:Class", "rdfs:label": "Charging quote", "rdfs:comment": "The CPO's answer: promised power and a start-time forecast band."},
