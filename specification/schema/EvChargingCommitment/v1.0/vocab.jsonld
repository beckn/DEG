    {"@id": "deg:promisedKW", "@type": "rdf:Property", "rdfs:label": "Promised power", "rdfs:comment": "Contractual reference power (kW) for delay and shortfall.", "rdfs:domain": "deg:Quote", "schema:rangeIncludes": "xsd:decimal"},
    {"@id": "deg:estimatedStart", "@type": "rdf:Property", "rdfs:label": "Estimated start", "rdfs:comment": "Forecast band (from, to) for stall assignment.", "rdfs:domain": "deg:Quote", "schema:rangeIncludes": "schema:Schedule"}
