                  "roleType": "AGGREGATOR",
                  "party": {
                    "partyId": "tata-ezcharge-mumbai",
                    "partyType": "PROVIDER",
                    "platformId": "bpp.tata-ezcharge.example.com"
                  },
                  "inputs": [
                    {
                      "inputId": "charger_id",
                      "inputType": "ITEM_REF",
                      "required": true,
                      "value": "IND*tata-ezcharge*cs-mum-01*IN*TATA*BKC*01*CCS2*A*V2G",
                      "providedAt": "TEMPLATE"
                    },
                    {
                      "inputId": "connector_type",
