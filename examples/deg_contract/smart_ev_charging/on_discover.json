                ]
              },
              "revenueModel": {
                "flows": [
                  {
                    "flowId": "charging_payment",
                    "from": "ev_owner",
                    "to": "cpo_aggregator",
                    "flowType": "ENERGY_PAYMENT",
                    "formula": {
                      "expr": "chargedKwh * chargingRatePerKwh",
                      "policyRef": {
                        "type": "REGO",
                        "package": "deg.contracts.ev_charging",
                        "entrypoint": "total_charge"
                      }
                    },
                    "currency": "INR",
                    "computedAmount": null,
                    "triggeredBy": "charging_payment",
