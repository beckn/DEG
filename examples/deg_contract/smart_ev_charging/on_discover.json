                  },
                  {
                    "flowId": "v2g_payment",
                    "from": "cpo_aggregator",
                    "to": "ev_owner",
                    "flowType": "INCENTIVE",
                    "formula": {
                      "expr": "dischargedKwh * 12.0"
                    },
                    "currency": "INR",
                    "computedAmount": null,
                    "triggeredBy": "v2g_payment_to_owner",
                    "schedule": "ON_DELIVERY"
                  },
                  {
                    "flowId": "grid_v2g_payment",
                    "from": "grid_operator",
                    "to": "cpo_aggregator",
                    "flowType": "GRID_SERVICE_FEE",
                    "formula": {
                      "expr": "dischargedKwh * 18.0"
                    },
                    "currency": "INR",
                    "computedAmount": null,
                    "triggeredBy": "grid_v2g_payment",
                    "schedule": "ON_SETTLEMENT"
                  },
                  {
                    "flowId": "platform_fee",
                    "from": "cpo_aggregator",
                    "to": "platform",
                    "flowType": "PLATFORM_FEE",
                    "formula": {
                      "expr": "chargingPayment * 0.02"
                    },
                    "currency": "INR",
                    "computedAmount": null,
                    "schedule": "ON_SETTLEMENT"
                  }
